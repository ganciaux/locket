{
	"name": "locket",
	"private": true,
	"engines": {
		"node": ">=24.12"
	},
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --project unit",
		"emulators": "firebase emulators:start --project demo-locket",
		"test:emulators": "vitest run --project emulators",
		"test:e2e": "firebase emulators:exec --only auth,firestore --project demo-locket \"playwright test\""
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@vite-pwa/sveltekit": "^1.1.0",
		"daisyui": "^5.7.50",
		"firebase-tools": "^15.34.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"firebase": "^13.1.0"
	}
}
