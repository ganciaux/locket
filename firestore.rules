rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Un chiffré : IV de 12 octets et données binaires, rien en clair (pas de base64).
    function isEncrypted(value) {
      return value is map
        && value.keys().hasOnly(['iv', 'data'])
        && value.iv is bytes && value.iv.size() == 12
        && value.data is bytes;
    }

    function isOptionalEncrypted(data, field) {
      return !(field in data) || isEncrypted(data[field]);
    }

    // `faceIdPepper` : aléa de 32 octets, sel de la clé de Face ID (ouvre les copies gardées sur les appareils).
    function isKeyring(data) {
      return data.keys().hasOnly(['wrappedDek', 'recoveryDek', 'keyringCheck', 'faceIdPepper'])
        && isEncrypted(data.wrappedDek)
        && isEncrypted(data.recoveryDek)
        && isOptionalEncrypted(data, 'keyringCheck')
        && (!('faceIdPepper' in data) || (data.faceIdPepper is bytes && data.faceIdPepper.size() == 32));
    }

    // Trousseau : sans lui, plus aucune connexion. L'app ne le supprime jamais.
    // Son sceau (`keyringCheck`) se remplace mais ne se retire pas : un `recoveryDek` remplacé resterait inaperçu.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isKeyring(request.resource.data);
      allow update: if isOwner(uid) && isKeyring(request.resource.data)
        && (!('keyringCheck' in resource.data) || 'keyringCheck' in request.resource.data);
      allow delete: if false;
    }

    match /users/{uid}/entries/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['data', 'thumb'])
        && isEncrypted(request.resource.data.data)
        && isOptionalEncrypted(request.resource.data, 'thumb');
    }

    match /users/{uid}/images/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['image'])
        && isEncrypted(request.resource.data.image);
    }

    match /users/{uid}/meta/{name} {
      allow read, delete: if isOwner(uid) && name in ['tags', 'collections', 'backup'];
      allow create, update: if isOwner(uid)
        && name in ['tags', 'collections', 'backup']
        && request.resource.data.keys().hasOnly(['data'])
        && isEncrypted(request.resource.data.data);
    }

    // Jeton de version des fiches : un aléa de 16 octets, sans contenu. L'app ne le supprime jamais.
    match /users/{uid}/meta/version {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['token'])
        && request.resource.data.token is bytes && request.resource.data.token.size() == 16;
    }

    // Tout le reste est refusé par défaut.
  }
}
