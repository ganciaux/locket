# Copier en .env.local et remplir avec l'objet firebaseConfig de la console Firebase
# (Paramètres du projet > Vos applications > Configuration du SDK).
# Ces valeurs ne sont pas secrètes : elles finissent dans le bundle JS.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=locket-403b5.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=locket-403b5
PUBLIC_FIREBASE_APP_ID=

# true = connexion aux émulateurs locaux (Auth 9099, Firestore 8080)
PUBLIC_USE_EMULATORS=true
